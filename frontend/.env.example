# ===================================================================
# Blockchain-Based Public Grievance Tracking System
# Smart Contract Deployed Addresses (Configured via Remix IDE)
# ===================================================================

VITE_ROLE_MANAGER_ADDRESS=
VITE_DEPARTMENT_MANAGER_ADDRESS=
VITE_GRIEVANCE_SYSTEM_ADDRESS=
VITE_ESCALATION_MANAGER_ADDRESS=
VITE_AUDIT_TRAIL_ADDRESS=

# Target Chain ID (e.g. 11155111 for Sepolia, 17000 for Holesky, 80002 for Polygon Amoy)
VITE_TARGET_CHAIN_ID=

# Read-only RPC provider URL for Public Verification page (no wallet required)
VITE_RPC_URL=

# ===================================================================
# Decentralized IPFS Storage Configuration
# ===================================================================
# Option 1: Organization-Controlled IPFS Node / Kubo RPC API (e.g., http://127.0.0.1:5001)
# Use this when running an internal or self-hosted IPFS Kubo daemon with proper CORS/access controls.
VITE_IPFS_API_URL=

# Option 2: Dedicated public or private gateway for reading IPFS content (e.g., https://ipfs.io)
VITE_IPFS_GATEWAY_URL=https://ipfs.io

# Option 3: Secure Server-Side Upload Proxy (e.g., https://api.yourdomain.gov/api/ipfs/upload)
# Production Architecture Recommendation:
#   Browser -> Secure Upload Proxy -> Pinning/IPFS Provider (Pinata, Infura, Filebase, etc.)
# All third-party pinning credentials (JWTs, API secrets) MUST reside on the server-side.
# Browser client bundles must NEVER contain privileged long-lived secrets or JWTs.
VITE_IPFS_UPLOAD_URL=
